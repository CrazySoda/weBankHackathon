# ClearTrade environment — copy to .env and fill in. NEVER commit .env.
# All provider keys live ONLY in the LiteLLM proxy (litellm section below).

# --- Core ---
CLEARTRADE_ENV=demo                      # demo | dev
DATABASE_URL=postgresql+asyncpg://cleartrade:cleartrade@localhost:5432/cleartrade
SYNC_DATABASE_URL=postgresql+psycopg://cleartrade:cleartrade@localhost:5432/cleartrade
REDIS_URL=redis://localhost:6379/0

# --- LiteLLM proxy ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-set-a-long-random-value
LITELLM_VIRTUAL_KEY=sk-virtual-key-with-spend-cap   # backend uses this, has spend cap
# Provider keys go to the LiteLLM proxy container ONLY:
ANTHROPIC_API_KEY=sk-ant-...

# --- Auth / crypto ---
# Signing key for approval signatures (ed25519 seed, base64). Generate:
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; import os,base64; print(base64.b64encode(Ed25519PrivateKey.generate().private_bytes_raw()).decode())"
APPROVAL_SIGNING_KEY=base64-seed-change-me

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000

# --- Budgets (step/token/cost kill switches) ---
BUDGET_MAX_STEPS=64
BUDGET_MAX_TOKENS_PER_DEAL=400000
BUDGET_MAX_COST_USD_PER_DEAL=5.00

# --- Sandbox payout ---
PAYOUT_MODE=sandbox                      # sandbox only; never 'live' in this repo
