# Copy this file to .env, then restrict its permissions:
#
#   cp .env.example .env
#   chmod 600 .env
#
# The real .env is ignored by Git. Never commit credentials.

# ── LLM provider & model selection ──────────────────────────────────────────
# Selects which provider the LiteLLM proxy routes `reasoner`/`fast` to.
# Supported: anthropic, openai, google, ollama
LLM_PROVIDER=anthropic

# Optional model overrides. Must be LiteLLM model strings WITH the provider
# prefix. Unset = curated defaults per provider:
#   anthropic → reasoner: anthropic/claude-sonnet-5-5   fast: anthropic/claude-haiku-5-5
#   openai    → reasoner: openai/gpt-4o                 fast: openai/gpt-4o-mini
#   google    → reasoner: gemini/gemini-3.5-pro         fast: gemini/gemini-3.5-flash
#   ollama    → reasoner: ollama/qwen3:32b              fast: ollama/qwen3:8b
# Examples:
#   LLM_REASONER_MODEL=anthropic/claude-opus-5-5
#   LLM_REASONER_MODEL=gemini/gemini-3.5-pro
#   LLM_FAST_MODEL=ollama/qwen3:8b
LLM_REASONER_MODEL=
LLM_FAST_MODEL=

# ── Provider credentials — comma-separated KEY ROTATION ─────────────────────
# Configure only the provider selected above (ollama needs no key).
#
# Comma-separate multiple keys to build a rotation pool: the LiteLLM router
# round-robins one deployment per key and automatically benches (cools down)
# any key that returns 429/503, retrying on the next key before the backend
# ever sees the error. One key is a valid pool.
#
#   # Free-tier Gemini: 5 req/min per key → 3 keys ≈ 15 req/min effective
#   GOOGLE_API_KEYS=key-1,key-2,key-3
#
# A single legacy var (ANTHROPIC_API_KEY / OPENAI_API_KEY / GOOGLE_API_KEY)
# is also honoured as a one-key pool.
ANTHROPIC_API_KEYS=
# OPENAI_API_KEYS=
# GOOGLE_API_KEYS=

# ── LiteLLM proxy ───────────────────────────────────────────────────────────
# Admin key for the proxy (never used by the backend). Generate something long:
#   uv run --directory backend python -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
LITELLM_MASTER_KEY=
# Backend authenticates with a VIRTUAL key created in the proxy with a spend
# cap (see README). The backend never holds provider keys.
LITELLM_VIRTUAL_KEY=
LITELLM_DB_URL=sqlite:///tmp/litellm.db

# ── Core services ───────────────────────────────────────────────────────────
CLEARTRADE_ENV=demo                       # demo | dev
DATABASE_URL=postgresql+asyncpg://cleartrade:cleartrade@localhost:5432/cleartrade
SYNC_DATABASE_URL=postgresql+psycopg://cleartrade:cleartrade@localhost:5432/cleartrade
REDIS_URL=redis://localhost:6379/0

# ── Auth / crypto ───────────────────────────────────────────────────────────
# Signing key for approval signatures (ed25519 seed, base64). Generate:
#   uv run --directory backend python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; import os,base64; print(base64.b64encode(Ed25519PrivateKey.generate().private_bytes_raw()).decode())"
APPROVAL_SIGNING_KEY=

# ── Observability (optional, profile obs) ───────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── Budgets (step/token/cost kill switches) ─────────────────────────────────
BUDGET_MAX_STEPS=64
BUDGET_MAX_TOKENS_PER_DEAL=400000
BUDGET_MAX_COST_MINOR_PER_DEAL=50000    # USD minor units ($500) hard ceiling

# ── Sandbox payout ──────────────────────────────────────────────────────────
PAYOUT_MODE=sandbox                      # sandbox only; never 'live' in this repo
